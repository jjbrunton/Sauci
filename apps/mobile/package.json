{
  "name": "@sauci/mobile",
  "version": "1.0.0",
  "private": true,
  "main": "./index.js",
  "scripts": {
    "dev": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:ci": "jest --runInBand --ci",
    "test:coverage": "jest --runInBand --ci --coverage",
    "release:ios": "dotenv -e .env -- eas build --platform ios --profile production --local",
    "release:ios:preview": "dotenv -e .env -- eas build --platform ios --profile preview --local",
    "release:android": "dotenv -e .env -- eas build --platform android --profile production --local",
    "release:android:preview": "dotenv -e .env -- eas build --platform android --profile preview --local",
    "release:android:upload": "bundle exec fastlane android upload",
    "release:android:ship": "bundle exec fastlane android release",
    "release:ios:upload": "bundle exec fastlane ios upload",
    "release:ios:ship": "bundle exec fastlane ios release",
    "release:preflight": "node scripts/release-preflight.mjs",
    "release:preflight:local-eas": "node scripts/release-preflight.mjs --local-eas",
    "ota:preflight:staging": "node scripts/ota-publish.mjs staging --preflight",
    "ota:preflight:production": "node scripts/ota-publish.mjs production --preflight",
    "ota:publish:staging": "node scripts/ota-publish.mjs staging",
    "ota:publish:production": "node scripts/ota-publish.mjs production",
    "test:ota-publish": "node --test scripts/ota-publish.test.mjs",
    "ota:rollback": "eoas rollback",
    "ota:doctor:staging": "node scripts/ota-publish.mjs staging --doctor",
    "ota:doctor:production": "node scripts/ota-publish.mjs production --doctor"
  },
  "dependencies": {
    "@bacons/apple-targets": "^5.0.0",
    "@bittingz/expo-widgets": "^3.0.2",
    "@expo/ngrok": "^4.1.0",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/cli": "^20.1.1",
    "@react-native-firebase/analytics": "^23.8.2",
    "@react-native-firebase/app": "^23.8.2",
    "@react-native-firebase/crashlytics": "^23.8.4",
    "@react-native-google-signin/google-signin": "^16.1.1",
    "@shopify/react-native-skia": "^2.6.9",
    "@supabase/supabase-js": "^2.39.0",
    "@tanstack/react-query": "^5.17.0",
    "babel-preset-expo": "~56.0.0",
    "base64-arraybuffer": "^1.0.2",
    "expo": "^56.0.0",
    "expo-apple-authentication": "~56.0.4",
    "expo-asset": "~56.0.24",
    "expo-audio": "~56.0.13",
    "expo-blur": "~56.0.4",
    "expo-build-properties": "~56.0.27",
    "expo-clipboard": "~56.0.4",
    "expo-constants": "~56.0.25",
    "expo-dev-client": "~56.0.26",
    "expo-file-system": "~56.0.11",
    "expo-font": "~56.0.7",
    "expo-haptics": "~56.0.3",
    "expo-image": "~56.0.12",
    "expo-image-picker": "~56.0.25",
    "expo-linear-gradient": "~56.0.4",
    "expo-linking": "~56.0.17",
    "expo-local-authentication": "~56.0.5",
    "expo-media-library": "~56.0.11",
    "expo-notifications": "~56.0.25",
    "expo-observe": "~56.0.29",
    "expo-router": "~56.2.20",
    "expo-secure-store": "~56.0.4",
    "expo-sharing": "~56.0.26",
    "expo-splash-screen": "~56.0.15",
    "expo-status-bar": "~56.0.4",
    "expo-system-ui": "~56.0.5",
    "expo-updates": "~56.0.26",
    "expo-video": "~56.1.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.85.3",
    "react-native-android-widget": "^0.22.1",
    "react-native-compressor": "^1.13.0",
    "react-native-gesture-handler": "~2.31.1",
    "react-native-purchases": "^9.6.12",
    "react-native-reanimated": "4.3.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-share": "^12.3.1",
    "react-native-svg": "15.15.4",
    "react-native-url-polyfill": "^2.0.0",
    "react-native-view-shot": "5.1.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.8.3",
    "zustand": "^4.4.7"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "29.5.14",
    "@types/node": "^20.19.0",
    "@types/react": "~19.2.14",
    "@types/react-test-renderer": "^19.1.0",
    "dotenv-cli": "^11.0.0",
    "eoas": "^3.1.3",
    "eslint": "^8.57.0",
    "eslint-config-expo": "~56.0.4",
    "jest": "^29.7.0",
    "jest-expo": "~56.0.5",
    "react-test-renderer": "19.2.3",
    "typescript": "~6.0.3"
  }
}
