# Hosted Supabase Auth public settings only. Admin product data and mutations go
# through VITE_API_URL; never expose a service-role or admin service token here.
VITE_SUPABASE_URL=your_nonproduction_supabase_auth_url
VITE_SUPABASE_ANON_KEY=your_nonproduction_supabase_anon_key
VITE_API_URL=http://127.0.0.1:3003
VITE_OPENAI_API_KEY=your_openai_api_key
VITE_OPENROUTER_API_KEY=your_openrouter_api_key

# AI Model Configuration
# VITE_AI_MODEL is the fallback for all operations
VITE_AI_MODEL=openai/gpt-4o-mini

# Granular model overrides (optional - each falls back to VITE_AI_MODEL)
# VITE_AI_MODEL_GENERATE - for pack/question/category generation
# VITE_AI_MODEL_FIX - for fix targets and fix text analysis
# VITE_AI_MODEL_POLISH - for polishing/tidying up text

# AI Council Configuration (multi-model review system)
# Set VITE_COUNCIL_ENABLED=true to enable multi-model review for question generation
# When enabled, a second model reviews generated questions for quality
VITE_COUNCIL_ENABLED=false
VITE_COUNCIL_GENERATOR_MODEL=anthropic/claude-3.5-sonnet
VITE_COUNCIL_REVIEWER_MODEL=google/gemini-pro-1.5
