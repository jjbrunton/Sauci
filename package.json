{
  "name": "sauci",
  "private": true,
  "workspaces": [
    "apps/api",
    "apps/admin",
    "apps/mcp",
    "apps/mobile",
    "apps/supabase",
    "apps/web",
    "e2e",
    "packages/*"
  ],
  "scripts": {
    "postinstall": "node scripts/fix-hoisting.js",
    "dev": "scripts/dev-local.sh up",
    "dev:turbo": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint && npm run lint:harness",
    "lint:harness": "node scripts/lint-harness.mjs",
    "test": "turbo test --filter=!@sauci/e2e",
    "test:coverage": "npm run test:coverage -w @sauci/api && npm run test:coverage -w @sauci/mobile",
    "test:supabase": "scripts/test-supabase.sh",
    "test:api:integration": "scripts/test-api-integration.sh",
    "test:mobile:e2e": "maestro test e2e/maestro",
    "verify:fast": "npm run lint && npm run typecheck && npm test",
    "verify:full": "npm run verify:fast && npm run build && npm run test:api:integration",
    "verify:e2e": "scripts/dev-local.sh e2e",
    "verify": "npm run verify:full && npm run verify:e2e",
    "db:start": "npx supabase start --workdir apps",
    "db:stop": "npx supabase stop --workdir apps",
    "db:reset": "npx supabase db reset --workdir apps",
    "db:migration:new": "npx supabase migration new --workdir apps",
    "learn:check": "node scripts/validate-learnings.mjs",
    "clean": "turbo clean",
    "typecheck": "turbo typecheck"
  },
  "dependencies": {
    "expo-router": "~56.2.20",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0"
  },
  "devDependencies": {
    "@types/react": "~19.1.10",
    "@types/react-dom": "~19.1.7",
    "patch-package": "^8.0.1",
    "react-test-renderer": "19.2.3",
    "supabase": "^2.39.2",
    "pg": "^8.17.2",
    "turbo": "^2.3.3",
    "typescript": "^5.3.3",
    "vitest": "^2.1.9"
  },
  "packageManager": "npm@10.2.0",
  "engines": {
    "node": ">=20 <21"
  },
  "overrides": {
    "rollup": "4.54.0",
    "react-native": "0.85.3",
    "expo": "~56.0.0",
    "@react-native/metro-config": "0.85.3"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-arm64-musl": "4.54.0",
    "@rollup/rollup-linux-x64-musl": "4.54.0"
  }
}
